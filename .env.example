# Host-facing URL. Used by `make dev`, `make migrate`, and `make test-integration`.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/jobtracker?sslmode=disable

# Inside docker compose the api service reaches Postgres by service name instead:
#   DATABASE_URL=postgres://postgres:postgres@postgres:5432/jobtracker?sslmode=disable
#
# On Render, use the Supabase SESSION pooler (port 5432), NOT the transaction
# pooler (6543) -- transaction pooling breaks golang-migrate's advisory lock and
# pgx's prepared-statement cache:
#   DATABASE_URL=postgres://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# HS256 signing key. Must be at least 32 bytes: RFC 7518 requires a key at
# least as long as the hash output, and a short secret is brute-forceable from
# one captured token -- at which point anyone can mint an admin. Generate one:
#   openssl rand -base64 32
JWT_SECRET=dev-only-change-me-0000000000000000000000
PORT=8080

# Optional. When both are set, the API upserts this admin account on startup.
ADMIN_EMAIL=
ADMIN_PASSWORD=
